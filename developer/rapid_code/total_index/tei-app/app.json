{
  "expo": {
    "name": "TEI",
    "slug": "tei-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tei",
    "icon": "./assets/ra-app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rhinoathletics.tei"
    },
    "android": {
      "package": "com.rhinoathletics.tei",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/ra-app-icon-foreground.png",
        "monochromeImage": "./assets/ra-app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/ra-app-icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
