{
  "expo": {
    "name": "TEI",
    "slug": "tei-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tei",
    "icon": "./assets/new/TEI-Mobile-App-1---Launcher-Icon-with-Gradient-Black---WEB.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rhinoathletics.tei",
      "buildNumber": "2",
      "appleTeamId": "UDD38L4JNJ",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rhinoathletics.tei",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/new/TEI-Mobile-App-1---Launcher-Icon-with-Gradient-Black---WEB.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/ra-app-icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c117d2d-e44f-4fe5-a8ad-8c6a2eb741fd"
      }
    },
    "owner": "uers"
  }
}
